# Zmienne środowiskowe projektu (wszystkie opcjonalne, bez sekretów).
# Python NIE wczytuje tego pliku sam — ustaw zmienne w powłoce albo w docker-compose.

# Dodatkowy katalog z własnymi dobami *.csv i/lub parametry.json (ma pierwszeństwo przed pakietem)
HEMS_DATA_DIR=
# Katalog, do którego GET /api/live zapisuje doba_live.csv + doba_live.meta.json
# (domyślnie data-local/ w repozytorium, ignorowany przez git)
HEMS_LIVE_DIR=
# Dozwolone originy CORS dla API, po przecinku (domyślnie localhost:5173 i :8080)
HEMS_CORS_ORIGINS=
